# Copy this file to .env and choose either SSH_ALIAS or HOST/USER.
# CLUSTER_SSH_ALIAS=my-cluster
# CLUSTER_HOST=login.cluster.example.org
# CLUSTER_TRANSFER_HOST=transfer.cluster.example.org
# CLUSTER_USER=researcher
# CLUSTER_SSH_KEY=~/.ssh/id_ed25519
CLUSTER_REMOTE_ROOT=.cluster-model-runner
CLUSTER_STATE_DIR=.nodus
CLUSTER_POLL_INTERVAL=15
CLUSTER_CONNECT_TIMEOUT=15
CLUSTER_DISCOVERY_TTL=60
CLUSTER_AUTO_PROBE=when-needed
CLUSTER_PROBE_MAX_PARALLEL=4
CLUSTER_PROBE_WAIT_TIMEOUT=900
CLUSTER_GPU_VRAM_RESERVE_GB=2
# Optional when SLURM does not advertise typed GPUs:
# CLUSTER_INVENTORY_FILE=profiles/example.inventory.json
# Optional explicit partition used only to build immutable venvs:
# CLUSTER_INSTALL_PARTITION=cpu-short
